# Main service alignment (root .env uses CONFIG_SERVICE_PORT=8080)
GOOSE_SERVER_URL=http://localhost:8080
GOOSE_POLL_INTERVAL_SECONDS=3

# One flagset per client path. Must exist in the SDK client's organization.
GOOSE_FLAGSET_POLLTEST=PollTest
GOOSE_FLAGSET_SSETEST=SSETest
GOOSE_FLAGSET_HOOKTEST=HookTest
GOOSE_NAMESPACE_POLLTEST=
GOOSE_NAMESPACE_SSETEST=
GOOSE_NAMESPACE_HOOKTEST=

# SDK client credentials (create in Config UI -> SDK Access tab).
# The secret is only needed for the webhook and config clients; flag polling /
# SSE authenticate with the client id alone.
GOOSE_SDK_CLIENT_ID=
GOOSE_SDK_CLIENT_SECRET=

# Optional webhook mode (skipped unless both the secret above and a target URL
# are set). Use host.docker.internal if the config service runs in Docker and the
# SDK runs on the host.
GOOSE_WEBHOOK_TARGET_URL=http://host.docker.internal:8091/webhook
GOOSE_WEBHOOK_SECRET=goose-local-webhook-secret
GOOSE_WEBHOOK_LISTENER_HOST=0.0.0.0
GOOSE_WEBHOOK_LISTENER_PORT=8091
GOOSE_WEBHOOK_LISTENER_PATH=/webhook

# Optional config watcher (skipped unless the secret above and a namespace are
# set). Names are comma-separated config document names within the namespace.
GOOSE_CONFIG_NAMESPACE=
GOOSE_CONFIG_NAMES=frontend,database

# Optional: this app's own version ("2.4.0"). When set, config entries carrying
# min_app_version/max_app_version are gated against it — an out-of-range entry
# resolves to its "default" instead of its "value". Unset means every entry applies.
GOOSE_APP_VERSION=
